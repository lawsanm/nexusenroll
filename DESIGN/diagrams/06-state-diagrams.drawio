<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="state-grade" name="State — GradeSubmission">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="State Diagram — GradeSubmission lifecycle&lt;br&gt;&lt;font style=&quot;font-size: 12px;font-weight:normal&quot;&gt;Requirement: &lt;i&gt;&quot;The system must have a process for grade approval (e.g. a &amp;quot;Pending&amp;quot; state before a final &amp;quot;Submitted&amp;quot; state).&quot;&lt;/i&gt;&amp;nbsp;&amp;nbsp;Realised with the State pattern ③.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1560" height="60" as="geometry" />
        </mxCell>

        <mxCell id="gInit" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="105" y="130" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gDraft" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Draft&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DraftState&lt;/font&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; entries := [ ]&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; accept addEntry(grade)&lt;br&gt;&lt;br&gt;&lt;i&gt;the faculty member is still&lt;br&gt;keying in the batch&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="200" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gPending" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;PendingApproval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;PendingApprovalState&amp;nbsp;&amp;nbsp;— the &quot;Pending&quot; state&lt;/font&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; BatchGradeProcessor validates&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; every entry &lt;u&gt;independently&lt;/u&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; await administrator decision&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; lock the entry set&lt;br&gt;&lt;br&gt;&lt;i&gt;addEntry() is refused here — the state&lt;br&gt;object raises IllegalTransition&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="185" width="330" height="165" as="geometry" />
        </mxCell>
        <mxCell id="gPartial" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;PartiallyRejected&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;PartiallyRejectedState&lt;/font&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; &lt;u&gt;retain&lt;/u&gt; all accepted entries;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; return only the rejected ones&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; accept correctEntry(grade)&lt;br&gt;&lt;br&gt;&lt;i&gt;this is the state that satisfies &quot;allow the&lt;br&gt;professor to correct it without losing&lt;br&gt;other submitted grades&quot;&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="490" width="330" height="175" as="geometry" />
        </mxCell>
        <mxCell id="gSubmitted" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Submitted&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SubmittedState&amp;nbsp;&amp;nbsp;— the final state&lt;/font&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; AcademicRecord.addGrade() for&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; each entry; recalculate GPA and&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; degree progress&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; publish(GradesSubmitted) ④&lt;br&gt;&lt;br&gt;&lt;i&gt;terminal — every transition is refused&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="185" width="340" height="165" as="geometry" />
        </mxCell>
        <mxCell id="gFinal" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1075" y="410" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="gt1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="gInit" target="gDraft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gt2" value="submitForApproval()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.4;fontSize=11;" edge="1" parent="1" source="gDraft" target="gPending"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gt3" value="approve(adminId)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[ every entry valid ]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.4;fontSize=11;strokeColor=#2d7a2d;fontColor=#2d7a2d;" edge="1" parent="1" source="gPending" target="gSubmitted"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gt4" value="[ one or more entries invalid ]&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;/ collect reasons&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.3;exitY=1;entryX=0.3;entryY=0;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="gPending" target="gPartial"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gt5" value="reject(reason)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;administrator declines the batch&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.75;exitY=1;entryX=0.75;entryY=0;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="gPending" target="gPartial"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gt6" value="correctEntry(grade) ; submitForApproval()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;accepted entries carry over unchanged&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.85;fontSize=11;strokeColor=#6c8ebf;fontColor=#2d5580;" edge="1" parent="1" source="gPartial" target="gPending"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="578" /><mxPoint x="390" y="325" /></Array></mxGeometry></mxCell>
        <mxCell id="gt7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gSubmitted" target="gFinal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gt8" value="correctEntry() / addEntry()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;self-transition while in Draft&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.75;exitY=0;entryX=0.35;entryY=0;fontSize=10;" edge="1" parent="1" source="gDraft" target="gDraft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="243" y="165" /><mxPoint x="143" y="165" /></Array></mxGeometry></mxCell>

        <mxCell id="gNoteA" value="&lt;b&gt;Why State ③ rather than an enum plus if/elif&lt;/b&gt;&lt;br&gt;&lt;br&gt;An enum-and-conditional design puts every rule about legal transitions in one growing block&lt;br&gt;inside GradeSubmission. Each new state multiplies the branches, and nothing prevents a caller&lt;br&gt;from mutating a submitted batch.&lt;br&gt;&lt;br&gt;With the State pattern each ConcreteState answers only for itself:&lt;br&gt;&amp;nbsp;&amp;nbsp;•&amp;nbsp; &lt;b&gt;DraftState&lt;/b&gt; permits addEntry() and submitForApproval()&lt;br&gt;&amp;nbsp;&amp;nbsp;•&amp;nbsp; &lt;b&gt;PendingApprovalState&lt;/b&gt; permits approve() and reject(), and &lt;u&gt;refuses&lt;/u&gt; addEntry()&lt;br&gt;&amp;nbsp;&amp;nbsp;•&amp;nbsp; &lt;b&gt;PartiallyRejectedState&lt;/b&gt; permits correctEntry() while keeping accepted grades&lt;br&gt;&amp;nbsp;&amp;nbsp;•&amp;nbsp; &lt;b&gt;SubmittedState&lt;/b&gt; refuses everything&lt;br&gt;&lt;br&gt;The base class default raises IllegalTransition, so an unhandled operation fails loudly instead of&lt;br&gt;corrupting the batch. Adding an &quot;UnderAudit&quot; state later is a new class — the Context is untouched&lt;br&gt;(Open/Closed Principle)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="700" width="710" height="260" as="geometry" />
        </mxCell>
        <mxCell id="gNoteB" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;&lt;br&gt;● &amp;nbsp;filled circle — initial pseudostate&lt;br&gt;◉ &amp;nbsp;ringed circle — final state&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; &amp;nbsp;action run on entering the state&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; &amp;nbsp;ongoing activity while in the state&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; &amp;nbsp;action run on leaving the state&lt;br&gt;&lt;b&gt;[ guard ]&lt;/b&gt; &amp;nbsp;condition that must hold&lt;br&gt;&lt;b&gt;event / action&lt;/b&gt; &amp;nbsp;trigger and its effect&lt;br&gt;&lt;br&gt;&lt;b&gt;Bold border&lt;/b&gt; = a state named explicitly in&lt;br&gt;the requirements document.&lt;br&gt;&lt;br&gt;Each state box names the &lt;b&gt;ConcreteState class&lt;/b&gt;&lt;br&gt;that implements it, so this diagram maps&lt;br&gt;one-to-one onto diagram 03." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="490" width="380" height="300" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="state-enrolment" name="State — Enrollment">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="State Diagram — Enrollment lifecycle&lt;br&gt;&lt;font style=&quot;font-size: 12px;font-weight:normal&quot;&gt;The lifecycle of the central business object. Transitions correspond to the EnrollmentStatus enumeration on diagram 02 and to the Command operations on diagram 03.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1560" height="60" as="geometry" />
        </mxCell>

        <mxCell id="eInit" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="eRequested" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Requested&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; build EnrollmentRequest&lt;br&gt;&lt;i&gt;transient — no state persisted yet&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="eValidating" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Validating&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; EnrollmentValidator runs every&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; ValidationRule ① and aggregates&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; the failures&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="195" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eEnrolled" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Enrolled&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; section.reserveSeat()&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; schedule.addSection()&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; publish(StudentEnrolled) ④&lt;br&gt;&lt;br&gt;&lt;i&gt;all three changes commit together&lt;br&gt;as one local ACID transaction ②&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="180" width="290" height="140" as="geometry" />
        </mxCell>
        <mxCell id="eWaitlisted" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Waitlisted&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Waitlist.add(studentId)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; await a SeatReleased event&lt;br&gt;&lt;br&gt;&lt;i&gt;reached only when the &lt;u&gt;capacity&lt;/u&gt; rule is&lt;br&gt;the sole failure — the student is&lt;br&gt;otherwise eligible&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="430" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="eRejected" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Rejected&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; return every failed rule&lt;br&gt;&lt;i&gt;nothing was persisted&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="eDropped" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Dropped&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; section.releaseSeat()&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; schedule.removeSection()&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; publish(SeatReleased) ④&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; publish(StudentDropped) ④&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;SeatReleased drives the waitlist alert,&lt;br&gt;StudentDropped the advisor alert&lt;/i&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="430" width="290" height="140" as="geometry" />
        </mxCell>
        <mxCell id="eCompleted" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Completed&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; AcademicRecord.addGrade()&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; recalculate degree progress&lt;br&gt;&lt;br&gt;&lt;i&gt;now counts toward prerequisite&lt;br&gt;checks for future enrolments&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="180" width="290" height="140" as="geometry" />
        </mxCell>

        <mxCell id="eF1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="170" y="570" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="eF2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="870" y="630" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="eF3" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1260" y="380" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="et1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.28;entryY=0;" edge="1" parent="1" source="eInit" target="eRequested"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et2" value="enrol()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;" edge="1" parent="1" source="eRequested" target="eValidating"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et3" value="[ result.isValid() ]&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;/ runAtomic(AddCourseCommand)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.4;fontSize=11;strokeColor=#2d7a2d;fontColor=#2d7a2d;" edge="1" parent="1" source="eValidating" target="eEnrolled"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et4" value="[ capacity rule is the only failure ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;strokeColor=#d6b656;fontColor=#8a6d1f;" edge="1" parent="1" source="eValidating" target="eWaitlisted"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et5" value="[ any other rule failed ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0;exitY=0.75;entryX=0.5;entryY=0;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="eValidating" target="eRejected"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="270" /><mxPoint x="330" y="360" /><mxPoint x="185" y="360" /></Array></mxGeometry></mxCell>
        <mxCell id="et6" value="SeatReleased&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[ first in queue ] / auto-enrol&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.3;entryX=0.5;entryY=1;fontSize=11;strokeColor=#2d7a2d;fontColor=#2d7a2d;" edge="1" parent="1" source="eWaitlisted" target="eEnrolled"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="474" /><mxPoint x="700" y="390" /><mxPoint x="885" y="390" /></Array></mxGeometry></mxCell>
        <mxCell id="et7" value="cancelWaitlist()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="eWaitlisted" target="eF1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="433" y="600" /><mxPoint x="185" y="600" /></Array></mxGeometry></mxCell>
        <mxCell id="et8" value="drop()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;/ runAtomic(DropCourseCommand)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="eEnrolled" target="eDropped"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et9" value="GradesSubmitted&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[ semester ended ]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.4;fontSize=11;strokeColor=#2d7a2d;fontColor=#2d7a2d;" edge="1" parent="1" source="eEnrolled" target="eCompleted"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eRejected" target="eF1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eDropped" target="eF2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eCompleted" target="eF3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et13" value="forceAdd(adminId)&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;administrator override — bypasses the capacity rule&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.75;entryX=0.25;entryY=1;fontSize=11;dashed=1;strokeColor=#9673a6;fontColor=#66497a;" edge="1" parent="1" source="eWaitlisted" target="eEnrolled"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="539" /><mxPoint x="690" y="410" /><mxPoint x="813" y="410" /></Array></mxGeometry></mxCell>

        <mxCell id="eNote" value="&lt;b&gt;Reading this diagram against the requirements&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Validating → Enrolled&lt;/b&gt; is the happy path of the §3.1 use case: &lt;i&gt;&quot;check if the student has the necessary prerequisites… check if there's available capacity… the enrolment is confirmed, and the student's schedule and academic record are updated.&quot;&lt;/i&gt; All three entry actions on &lt;b&gt;Enrolled&lt;/b&gt; commit as one transaction.&lt;br&gt;&lt;br&gt;&lt;b&gt;Validating → Waitlisted vs. Validating → Rejected&lt;/b&gt; is a deliberate design distinction. A student who fails only the capacity check is eligible and is queued; a student missing a prerequisite is not eligible and must be refused. Collapsing these into one &quot;failed&quot; state would make the waitlist requirement unimplementable.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dropped&lt;/b&gt; publishes StudentDropped, which is what drives the automated waitlist alert in diagram 05 page 2.&lt;br&gt;&lt;br&gt;&lt;b&gt;Completed&lt;/b&gt; feeds back into &lt;b&gt;PrerequisiteRule&lt;/b&gt;: a completed course becomes an input to future prerequisite checks, closing the loop between the Academic Records and Enrolment contexts.&lt;br&gt;&lt;br&gt;The dashed purple transition is the administrator override from §3.3 — &lt;i&gt;&quot;force-add a student into a full class&quot;&lt;/i&gt; — modelled as a legal transition rather than a special case buried in code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="1370" height="270" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="state-changereq" name="State — CourseChangeRequest">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t3" value="State Diagram — CourseChangeRequest lifecycle&lt;br&gt;&lt;font style=&quot;font-size: 12px;font-weight:normal&quot;&gt;Requirement: &lt;i&gt;&quot;Instructors can submit requests to update course descriptions, add prerequisites, or change course capacity (these requests must be approved by an administrator).&quot;&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1560" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cInit" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="140" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cDraft" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Draft&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; capture changeType&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; and payload&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; faculty edits the request&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="210" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cPending" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;PendingAdminApproval&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; notify administrators ④&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; await administrator decision&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; record who decided, and when&lt;br&gt;&lt;br&gt;&lt;i&gt;the change is &lt;u&gt;not&lt;/u&gt; applied to the live&lt;br&gt;CourseSection while in this state&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="195" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cApproved" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Approved&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; apply the change to the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; live CourseSection&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; publish(CourseChanged) ④&lt;br&gt;&lt;br&gt;&lt;i&gt;a capacity increase here can release&lt;br&gt;seats, which in turn triggers the&lt;br&gt;waitlist notification&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="160" width="320" height="155" as="geometry" />
        </mxCell>
        <mxCell id="cRejected" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Rejected&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; store the reason&lt;br&gt;&lt;b&gt;entry /&lt;/b&gt; notify the requesting faculty&lt;br&gt;&lt;i&gt;the live section is unchanged&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="400" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cWithdrawn" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Withdrawn&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;i&gt;the faculty member withdrew&lt;br&gt;the request before a decision&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="430" width="290" height="85" as="geometry" />
        </mxCell>

        <mxCell id="cF1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1230" y="222" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cF2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1230" y="437" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cF3" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="545" y="580" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ct1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.26;entryY=0;" edge="1" parent="1" source="cInit" target="cDraft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ct2" value="submit()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;" edge="1" parent="1" source="cDraft" target="cPending"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ct3" value="approve(adminId)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;fontSize=11;strokeColor=#2d7a2d;fontColor=#2d7a2d;" edge="1" parent="1" source="cPending" target="cApproved"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ct4" value="reject(reason)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.8;entryX=0;entryY=0.4;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="cPending" target="cRejected"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ct5" value="withdraw()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="cPending" target="cWithdrawn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ct6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="cApproved" target="cF1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ct7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="cRejected" target="cF2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ct8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.45;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cWithdrawn" target="cF3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ct9" value="revise() ; resubmit()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0;exitY=0.8;entryX=0.5;entryY=1;fontSize=11;dashed=1;strokeColor=#6c8ebf;fontColor=#2d5580;" edge="1" parent="1" source="cRejected" target="cDraft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="484" /><mxPoint x="790" y="560" /><mxPoint x="175" y="560" /></Array></mxGeometry></mxCell>
        <mxCell id="ct10" value="edit()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;self-transition&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.75;exitY=0;entryX=0.35;entryY=0;fontSize=10;" edge="1" parent="1" source="cDraft" target="cDraft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="238" y="175" /><mxPoint x="138" y="175" /></Array></mxGeometry></mxCell>

        <mxCell id="cNote" value="&lt;b&gt;Design points worth stating in the report&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&amp;nbsp; The request is a first-class object, not a flag.&lt;/b&gt; Modelling the approval workflow as its own entity with its own lifecycle keeps the audit trail (who requested what, who decided, when, and why) without polluting CourseSection with approval fields. Single Responsibility Principle at the entity level.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&amp;nbsp; The live section is only mutated on entry to Approved.&lt;/b&gt; While the request sits in PendingAdminApproval the published catalogue is unaffected, so students never see a capacity or prerequisite that has not been authorised. This is the whole point of the requirement that these requests &lt;i&gt;&quot;must be approved by an administrator.&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&amp;nbsp; The same State pattern ③ implementation serves two entities.&lt;/b&gt; GradeSubmission and CourseChangeRequest both follow a Draft → Pending → terminal shape, so the pattern is applied twice with different ConcreteState families. Reusing one design idea across two workflows is the DRY principle operating at the design level rather than the code level.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&amp;nbsp; Approving a capacity increase cascades.&lt;/b&gt; The entry action publishes CourseChanged; a capacity increase releases seats, and the existing WaitlistObserver ④ picks that up with no extra code. Two independently designed features compose because both are event-driven." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="650" width="1330" height="300" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
