        <mxCell id="dbNote" value="&lt;i&gt;Database-per-service: no shared schema,&lt;br&gt;therefore no schema coupling between services&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="360" height="30" as="geometry" />
        </mxCell>

        <mxCell id="broker" value="MESSAGE BROKER  /  EVENT BUS&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Asynchronous durable publish–subscribe · Topics: &lt;b&gt;StudentEnrolled&lt;/b&gt; · &lt;b&gt;StudentDropped&lt;/b&gt; · &lt;b&gt;SeatReleased&lt;/b&gt; · &lt;b&gt;GradesSubmitted&lt;/b&gt; · &lt;b&gt;CourseChanged&lt;/b&gt; · &lt;b&gt;SystemError&lt;/b&gt;&lt;br&gt;Decouples producers from consumers · Buffers peak load · Retry + dead-letter queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1560" height="80" as="geometry" />
