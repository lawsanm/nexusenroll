        <mxCell id="emailgw" value="Email / SMS Gateway&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;EXTERNAL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
