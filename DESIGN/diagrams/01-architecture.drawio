        </mxCell>
        <mxCell id="svcNotifApi" value="Event Subscriber Layer&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;consumes domain events from the broker&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="svcNotif">
