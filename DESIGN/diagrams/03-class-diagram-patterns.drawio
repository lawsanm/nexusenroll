      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="stImpl3" edge="1" parent="1" source="PartiallyRejectedState" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.63;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;" target="GradeState">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="stImpl4" edge="1" parent="1" source="SubmittedState" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;" target="GradeState">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="stCtx" edge="1" parent="1" source="GradeSubmissionCtx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.556;exitY=0.036;exitDx=0;exitDy=0;entryX=0.564;entryY=0.995;entryDx=0;entryDy=0;strokeColor=#9673a6;fontSize=10;exitPerimeter=0;entryPerimeter=0;" target="GradeState" value="- state    1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="zObserver" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefaef;strokeColor=#d6b656;dashed=1;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#8a6d1f;" value="④ OBSERVER  «Behavioural»  —  Notification system&lt;br&gt;&lt;font style=&quot;font-size: 10px;font-weight:normal&quot;&gt;&lt;i&gt;Requirement: &quot;This process should be automated and &lt;b&gt;decoupled&lt;/b&gt; from the core enrolment logic.&quot;&lt;br&gt;Why: the subject publishes an event and knows nothing about who consumes it. Adding a recipient is a new observer class with zero change to enrolment code.&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="595" width="860" x="920" y="775" as="geometry" />
    </mxCell>
    <mxCell id="NotificationPublisher" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Subject&lt;/i&gt;&lt;br&gt;&lt;b&gt;NotificationPublisher&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- observers: Map&amp;lt;EventType, List&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ attach(type, o: EventObserver): void&lt;br&gt;+ detach(type, o): void&lt;br&gt;+ publish(e: DomainEvent): void&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;an observer raising an exception is logged and&lt;br&gt;isolated — it cannot fail the enrolment&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="130" width="320" x="945" y="860" as="geometry" />
    </mxCell>
