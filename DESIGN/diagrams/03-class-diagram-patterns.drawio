<mxGraphModel dx="2943" dy="1606" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2900" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="NexusEnroll — Design Pattern Structures in the Business Logic Tier&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Seven patterns across all three GoF families. Each zone names the pattern, its GoF roles, and the specific requirement it satisfies. The final panel records the patterns we considered and rejected, and why.&lt;/font&gt;" vertex="1">
      <mxGeometry height="60" width="1520" x="40" y="10" as="geometry" />
    </mxCell>
    <mxCell id="zStrategy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8f0;strokeColor=#82b366;dashed=1;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3d6b2e;" value="① STRATEGY  «Behavioural»  —  Enrolment validation rules&lt;br&gt;&lt;font style=&quot;font-size: 10px;font-weight:normal&quot;&gt;&lt;i&gt;Requirement: &quot;The system must validate all enrolment requests&quot; — prerequisite, capacity and time-conflict checks.&lt;br&gt;Why: each rule is an interchangeable algorithm. A new rule (e.g. credit-limit) is a new class, with &lt;b&gt;no change&lt;/b&gt; to the validator — Open/Closed Principle.&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="620" width="790" x="40" y="90" as="geometry" />
    </mxCell>
    <mxCell id="ValidationRule" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»  — Strategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;ValidationRule&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ validate(req: EnrollmentRequest,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ctx: EnrolmentContext): ValidationResult&lt;br&gt;+ ruleName(): String" vertex="1">
      <mxGeometry height="90" width="320" x="250" y="180" as="geometry" />
    </mxCell>
    <mxCell id="PrerequisiteRule" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteStrategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;PrerequisiteRule&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- recordRepo: IRecordRepository&lt;hr size=&quot;1&quot;&gt;+ validate(req, ctx)&lt;br&gt;+ ruleName()&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;Student must have completed&lt;br&gt;all prerequisites&lt;/i&gt;" vertex="1">
      <mxGeometry height="130" width="225" x="60" y="380" as="geometry" />
    </mxCell>
    <mxCell id="CapacityRule" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteStrategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;CapacityRule&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- sectionRepo: ISectionRepository&lt;hr size=&quot;1&quot;&gt;+ validate(req, ctx)&lt;br&gt;+ ruleName()&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;The course cannot be full&lt;br&gt;(bypassed on admin override)&lt;/i&gt;" vertex="1">
      <mxGeometry height="130" width="220" x="340" y="380" as="geometry" />
    </mxCell>
    <mxCell id="TimeConflictRule" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteStrategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;TimeConflictRule&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- scheduleRepo: IScheduleRepository&lt;hr size=&quot;1&quot;&gt;+ validate(req, ctx)&lt;br&gt;+ ruleName()&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;Must not overlap an&lt;br&gt;already-enrolled course&lt;/i&gt;" vertex="1">
      <mxGeometry height="130" width="225" x="585" y="380" as="geometry" />
    </mxCell>
    <mxCell id="EnrollmentValidator" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Context&lt;/i&gt;&lt;br&gt;&lt;b&gt;EnrollmentValidator&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- rules: List&amp;lt;ValidationRule&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ addRule(r: ValidationRule): void&lt;br&gt;+ validateAll(req): ValidationResult&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;iterates rules; aggregates every failure so the&lt;br&gt;student sees all problems at once, not just the first&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="130" width="320" x="235" y="540" as="geometry" />
    </mxCell>
    <mxCell id="sImpl1" edge="1" parent="1" source="PrerequisiteRule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;" target="ValidationRule">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="sImpl2" edge="1" parent="1" source="CapacityRule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;" target="ValidationRule">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="sImpl3" edge="1" parent="1" source="TimeConflictRule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;" target="ValidationRule">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="sAgg" edge="1" parent="1" source="EnrollmentValidator" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=diamondThin;startFill=0;startSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;fontSize=10;curved=1;" target="ValidationRule" value="1     1..*">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="310" y="540.06" />
          <mxPoint x="310" y="330.06" />
          <mxPoint x="410" y="330.06" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="zCommand" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f6fb;strokeColor=#6c8ebf;dashed=1;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#2d5580;" value="② COMMAND  «Behavioural»  —  Transactional add / drop&lt;br&gt;&lt;font style=&quot;font-size: 10px;font-weight:normal&quot;&gt;&lt;i&gt;Requirement: &quot;either the entire operation succeeds… or the entire operation fails, leaving no partial state changes.&quot;&lt;br&gt;Why: encapsulating each operation as an object with execute()/undo() gives a natural rollback path. The invoker unwinds completed steps in reverse on any failure.&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="620" width="850" x="920" y="90" as="geometry" />
    </mxCell>
    <mxCell id="EnrollmentCommand" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»  — Command&lt;/i&gt;&lt;br&gt;&lt;b&gt;EnrollmentCommand&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ execute(): void&lt;br&gt;+ undo(): void&lt;br&gt;+ describe(): String" vertex="1">
      <mxGeometry height="88" width="320" x="1130" y="175" as="geometry" />
    </mxCell>
    <mxCell id="AddCourseCommand" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteCommand&lt;/i&gt;&lt;br&gt;&lt;b&gt;AddCourseCommand&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- request: EnrollmentRequest&lt;br&gt;- receiver: EnrolmentReceiver&lt;br&gt;- createdEnrolmentId: String&lt;hr size=&quot;1&quot;&gt;+ execute()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;nbsp;&amp;nbsp;1. create Enrollment&lt;br&gt;&amp;nbsp;&amp;nbsp;2. section.reserveSeat()&lt;br&gt;&amp;nbsp;&amp;nbsp;3. schedule.addSection()&lt;/font&gt;&lt;br&gt;+ undo()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;nbsp;&amp;nbsp;reverses 3 → 2 → 1&lt;/font&gt;" vertex="1">
      <mxGeometry height="160" width="330" x="935" y="340" as="geometry" />
    </mxCell>
    <mxCell id="DropCourseCommand" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteCommand&lt;/i&gt;&lt;br&gt;&lt;b&gt;DropCourseCommand&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- enrolmentId: String&lt;br&gt;- receiver: EnrolmentReceiver&lt;br&gt;- snapshot: EnrolmentSnapshot&lt;hr size=&quot;1&quot;&gt;+ execute()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;nbsp;&amp;nbsp;1. enrolment.drop()&lt;br&gt;&amp;nbsp;&amp;nbsp;2. section.releaseSeat()&lt;br&gt;&amp;nbsp;&amp;nbsp;3. schedule.removeSection()&lt;/font&gt;&lt;br&gt;+ undo()  &lt;font style=&quot;font-size:9px&quot;&gt;restores snapshot&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;no events published here — StudentDropped and&lt;br&gt;SeatReleased are published by the Facade after commit&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="172" width="340" x="1410" y="359" as="geometry" />
    </mxCell>
    <mxCell id="TransactionManager" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Invoker&lt;/i&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;TransactionManager&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- executed: Stack&amp;lt;EnrollmentCommand&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ runAtomic(cmds: List): TxResult&amp;nbsp;&amp;nbsp;&amp;nbsp;- rollbackAll(): void&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;on failure, pops the stack calling undo() on every already-&lt;br&gt;executed command — no partial state change survives&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="115" width="380" x="1155" y="547.5" as="geometry" />
    </mxCell>
    <mxCell id="cInvoke" edge="1" parent="1" source="TransactionManager" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontSize=10;curved=1;" target="EnrollmentCommand" value="invokes  1..*">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1345" y="390" />
          <mxPoint x="1290" y="390" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="cImpl1" edge="1" parent="1" source="AddCourseCommand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;strokeColor=#6c8ebf;" target="EnrollmentCommand">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="cImpl2" edge="1" parent="1" source="DropCourseCommand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;strokeColor=#6c8ebf;" target="EnrollmentCommand">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="zState" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f3f9;strokeColor=#9673a6;dashed=1;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#66497a;" value="③ STATE  «Behavioural»  —  Grade submission lifecycle&lt;br&gt;&lt;font style=&quot;font-size: 10px;font-weight:normal&quot;&gt;&lt;i&gt;Requirement: &quot;The system must have a process for grade approval (e.g. a &amp;quot;Pending&amp;quot; state before a final &amp;quot;Submitted&amp;quot; state).&quot;&lt;br&gt;Why: behaviour depends entirely on the current state. State classes replace a sprawling if/elif chain, and each class enforces which transitions are legal.&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="595" width="800" x="40" y="775" as="geometry" />
    </mxCell>
    <mxCell id="GradeState" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»  — State&lt;/i&gt;&lt;br&gt;&lt;b&gt;GradeState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ addEntry(ctx, grade): void&lt;br&gt;+ submitForApproval(ctx): void&lt;br&gt;+ approve(ctx): void&lt;br&gt;+ reject(ctx, reason): void&lt;br&gt;+ correctEntry(ctx, grade): void&lt;br&gt;+ name(): String&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;default implementations raise IllegalTransition&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="130" width="350" x="235" y="860" as="geometry" />
    </mxCell>
    <mxCell id="DraftState" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteState&lt;/i&gt;&lt;br&gt;&lt;b&gt;DraftState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ addEntry ✔&lt;br&gt;+ submitForApproval ✔&lt;br&gt;+ approve ✘&lt;br&gt;+ reject ✘" vertex="1">
      <mxGeometry height="105" width="165" x="55" y="1080" as="geometry" />
    </mxCell>
    <mxCell id="PendingApprovalState" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteState&lt;/i&gt;&lt;br&gt;&lt;b&gt;PendingApprovalState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ approve ✔&lt;br&gt;+ reject ✔&lt;br&gt;+ addEntry ✘&lt;br&gt;+ submitForApproval ✘" vertex="1">
      <mxGeometry height="105" width="175" x="232" y="1080" as="geometry" />
    </mxCell>
    <mxCell id="PartiallyRejectedState" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteState&lt;/i&gt;&lt;br&gt;&lt;b&gt;PartiallyRejectedState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ correctEntry ✔&lt;br&gt;+ submitForApproval ✔&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;valid grades already accepted&lt;br&gt;are retained&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="105" width="175" x="450" y="1080" as="geometry" />
    </mxCell>
    <mxCell id="SubmittedState" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteState&lt;/i&gt;&lt;br&gt;&lt;b&gt;SubmittedState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;terminal&lt;/i&gt;&lt;br&gt;all transitions ✘&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;academic records updated&lt;/font&gt;" vertex="1">
      <mxGeometry height="105" width="155" x="655" y="1070" as="geometry" />
    </mxCell>
    <mxCell id="GradeSubmissionCtx" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Context&lt;/i&gt;&lt;br&gt;&lt;b&gt;GradeSubmission&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- state: GradeState&lt;br&gt;- entries: List&amp;lt;Grade&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ submitForApproval()&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;→ state.submitForApproval(this)&lt;/font&gt;&lt;br&gt;+ approve()&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;→ state.approve(this)&lt;/font&gt;&lt;br&gt;+ setState(s: GradeState): void" vertex="1">
      <mxGeometry height="130" width="350" x="235" y="1210" as="geometry" />
    </mxCell>
    <mxCell id="stImpl1" edge="1" parent="1" source="DraftState" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;" target="GradeState">
      <mxGeometry relative="1" as="geometry" />
