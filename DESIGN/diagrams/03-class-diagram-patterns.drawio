<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="nexusenroll-patterns" name="Class Diagram — Design Pattern Structures">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="NexusEnroll — Design Pattern Structures in the Business Logic Tier&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Seven patterns across all three GoF families. Each zone names the pattern, its GoF roles, and the specific requirement it satisfies. The final panel records the patterns we considered and rejected, and why.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1520" height="60" as="geometry" />
        </mxCell>

        <!-- ============ STRATEGY ============ -->
        <mxCell id="zStrategy" value="① STRATEGY  «Behavioural»  —  Enrolment validation rules&lt;br&gt;&lt;font style=&quot;font-size: 10px;font-weight:normal&quot;&gt;&lt;i&gt;Requirement: &quot;The system must validate all enrolment requests&quot; — prerequisite, capacity and time-conflict checks.&lt;br&gt;Why: each rule is an interchangeable algorithm. A new rule (e.g. credit-limit) is a new class, with &lt;b&gt;no change&lt;/b&gt; to the validator — Open/Closed Principle.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8f0;strokeColor=#82b366;dashed=1;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3d6b2e;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="740" height="450" as="geometry" />
        </mxCell>
        <mxCell id="ValidationRule" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»  — Strategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;ValidationRule&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ validate(req: EnrollmentRequest,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ctx: EnrolmentContext): ValidationResult&lt;br&gt;+ ruleName(): String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="180" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="PrerequisiteRule" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteStrategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;PrerequisiteRule&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- recordRepo: IRecordRepository&lt;hr size=&quot;1&quot;&gt;+ validate(req, ctx)&lt;br&gt;+ ruleName()&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;Student must have completed&lt;br&gt;all prerequisites&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="225" height="130" as="geometry" />
        </mxCell>
        <mxCell id="CapacityRule" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteStrategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;CapacityRule&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- sectionRepo: ISectionRepository&lt;hr size=&quot;1&quot;&gt;+ validate(req, ctx)&lt;br&gt;+ ruleName()&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;The course cannot be full&lt;br&gt;(bypassed on admin override)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="300" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="TimeConflictRule" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteStrategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;TimeConflictRule&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- scheduleRepo: IScheduleRepository&lt;hr size=&quot;1&quot;&gt;+ validate(req, ctx)&lt;br&gt;+ ruleName()&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;Must not overlap an&lt;br&gt;already-enrolled course&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="535" y="300" width="225" height="130" as="geometry" />
        </mxCell>
        <mxCell id="EnrollmentValidator" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Context&lt;/i&gt;&lt;br&gt;&lt;b&gt;EnrollmentValidator&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- rules: List&amp;lt;ValidationRule&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ addRule(r: ValidationRule): void&lt;br&gt;+ validateAll(req): ValidationResult&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;iterates rules; aggregates every failure so the&lt;br&gt;student sees all problems at once, not just the first&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="450" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sImpl1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;" edge="1" parent="1" source="PrerequisiteRule" target="ValidationRule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sImpl2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;" edge="1" parent="1" source="CapacityRule" target="ValidationRule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sImpl3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;" edge="1" parent="1" source="TimeConflictRule" target="ValidationRule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sAgg" value="1     1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=diamondThin;startFill=0;startSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="EnrollmentValidator" target="ValidationRule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ COMMAND ============ -->
        <mxCell id="zCommand" value="② COMMAND  «Behavioural»  —  Transactional add / drop&lt;br&gt;&lt;font style=&quot;font-size: 10px;font-weight:normal&quot;&gt;&lt;i&gt;Requirement: &quot;either the entire operation succeeds… or the entire operation fails, leaving no partial state changes.&quot;&lt;br&gt;Why: encapsulating each operation as an object with execute()/undo() gives a natural rollback path. The invoker unwinds completed steps in reverse on any failure.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f6fb;strokeColor=#6c8ebf;dashed=1;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#2d5580;" vertex="1" parent="1">
          <mxGeometry x="920" y="90" width="740" height="450" as="geometry" />
        </mxCell>
        <mxCell id="EnrollmentCommand" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»  — Command&lt;/i&gt;&lt;br&gt;&lt;b&gt;EnrollmentCommand&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ execute(): void&lt;br&gt;+ undo(): void&lt;br&gt;+ describe(): String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1130" y="175" width="320" height="88" as="geometry" />
        </mxCell>
        <mxCell id="AddCourseCommand" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteCommand&lt;/i&gt;&lt;br&gt;&lt;b&gt;AddCourseCommand&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- request: EnrollmentRequest&lt;br&gt;- receiver: EnrolmentReceiver&lt;br&gt;- createdEnrolmentId: String&lt;hr size=&quot;1&quot;&gt;+ execute()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;nbsp;&amp;nbsp;1. create Enrollment&lt;br&gt;&amp;nbsp;&amp;nbsp;2. section.reserveSeat()&lt;br&gt;&amp;nbsp;&amp;nbsp;3. schedule.addSection()&lt;/font&gt;&lt;br&gt;+ undo()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;nbsp;&amp;nbsp;reverses 3 → 2 → 1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="945" y="278" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="DropCourseCommand" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteCommand&lt;/i&gt;&lt;br&gt;&lt;b&gt;DropCourseCommand&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- enrolmentId: String&lt;br&gt;- receiver: EnrolmentReceiver&lt;br&gt;- snapshot: EnrolmentSnapshot&lt;hr size=&quot;1&quot;&gt;+ execute()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&amp;nbsp;&amp;nbsp;1. enrolment.drop()&lt;br&gt;&amp;nbsp;&amp;nbsp;2. section.releaseSeat()&lt;br&gt;&amp;nbsp;&amp;nbsp;3. schedule.removeSection()&lt;/font&gt;&lt;br&gt;+ undo()  &lt;font style=&quot;font-size:9px&quot;&gt;restores snapshot&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;no events published here — StudentDropped and&lt;br&gt;SeatReleased are published by the Facade after commit&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1295" y="278" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TransactionManager" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Invoker&lt;/i&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;TransactionManager&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- executed: Stack&amp;lt;EnrollmentCommand&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ runAtomic(cmds: List): TxResult&amp;nbsp;&amp;nbsp;&amp;nbsp;- rollbackAll(): void&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;on failure, pops the stack calling undo() on every already-&lt;br&gt;executed command — no partial state change survives&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="448" width="380" height="86" as="geometry" />
        </mxCell>
        <mxCell id="cInvoke" value="invokes  1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="TransactionManager" target="EnrollmentCommand">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1290" y="443" />
              <mxPoint x="1285" y="443" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cImpl1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="AddCourseCommand" target="EnrollmentCommand">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cImpl2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="DropCourseCommand" target="EnrollmentCommand">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ STATE ============ -->
        <mxCell id="zState" value="③ STATE  «Behavioural»  —  Grade submission lifecycle&lt;br&gt;&lt;font style=&quot;font-size: 10px;font-weight:normal&quot;&gt;&lt;i&gt;Requirement: &quot;The system must have a process for grade approval (e.g. a &amp;quot;Pending&amp;quot; state before a final &amp;quot;Submitted&amp;quot; state).&quot;&lt;br&gt;Why: behaviour depends entirely on the current state. State classes replace a sprawling if/elif chain, and each class enforces which transitions are legal.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f3f9;strokeColor=#9673a6;dashed=1;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#66497a;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="740" height="470" as="geometry" />
        </mxCell>
        <mxCell id="GradeState" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»  — State&lt;/i&gt;&lt;br&gt;&lt;b&gt;GradeState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ addEntry(ctx, grade): void&lt;br&gt;+ submitForApproval(ctx): void&lt;br&gt;+ approve(ctx): void&lt;br&gt;+ reject(ctx, reason): void&lt;br&gt;+ correctEntry(ctx, grade): void&lt;br&gt;+ name(): String&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;default implementations raise IllegalTransition&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="235" y="745" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="DraftState" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteState&lt;/i&gt;&lt;br&gt;&lt;b&gt;DraftState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ addEntry ✔&lt;br&gt;+ submitForApproval ✔&lt;br&gt;+ approve ✘&lt;br&gt;+ reject ✘" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="905" width="165" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PendingApprovalState" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteState&lt;/i&gt;&lt;br&gt;&lt;b&gt;PendingApprovalState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ approve ✔&lt;br&gt;+ reject ✔&lt;br&gt;+ addEntry ✘&lt;br&gt;+ submitForApproval ✘" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="232" y="905" width="175" height="105" as="geometry" />
        </mxCell>
        <mxCell id="PartiallyRejectedState" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteState&lt;/i&gt;&lt;br&gt;&lt;b&gt;PartiallyRejectedState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ correctEntry ✔&lt;br&gt;+ submitForApproval ✔&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;valid grades already accepted&lt;br&gt;are retained&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="419" y="905" width="175" height="105" as="geometry" />
        </mxCell>
        <mxCell id="SubmittedState" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteState&lt;/i&gt;&lt;br&gt;&lt;b&gt;SubmittedState&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;terminal&lt;/i&gt;&lt;br&gt;all transitions ✘&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;academic records updated&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="606" y="905" width="155" height="105" as="geometry" />
        </mxCell>
        <mxCell id="GradeSubmissionCtx" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Context&lt;/i&gt;&lt;br&gt;&lt;b&gt;GradeSubmission&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- state: GradeState&lt;br&gt;- entries: List&amp;lt;Grade&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ submitForApproval()&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;→ state.submitForApproval(this)&lt;/font&gt;&lt;br&gt;+ approve()&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;→ state.approve(this)&lt;/font&gt;&lt;br&gt;+ setState(s: GradeState): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="235" y="1030" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stImpl1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="DraftState" target="GradeState">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stImpl2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.37;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="PendingApprovalState" target="GradeState">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stImpl3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.63;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="PartiallyRejectedState" target="GradeState">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stImpl4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=14;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="SubmittedState" target="GradeState">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stCtx" value="- state    1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="GradeSubmissionCtx" target="GradeState">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ OBSERVER ============ -->
        <mxCell id="zObserver" value="④ OBSERVER  «Behavioural»  —  Notification system&lt;br&gt;&lt;font style=&quot;font-size: 10px;font-weight:normal&quot;&gt;&lt;i&gt;Requirement: &quot;This process should be automated and &lt;b&gt;decoupled&lt;/b&gt; from the core enrolment logic.&quot;&lt;br&gt;Why: the subject publishes an event and knows nothing about who consumes it. Adding a recipient is a new observer class with zero change to enrolment code.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefaef;strokeColor=#d6b656;dashed=1;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#8a6d1f;" vertex="1" parent="1">
          <mxGeometry x="920" y="660" width="740" height="470" as="geometry" />
        </mxCell>
        <mxCell id="NotificationPublisher" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Subject&lt;/i&gt;&lt;br&gt;&lt;b&gt;NotificationPublisher&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- observers: Map&amp;lt;EventType, List&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ attach(type, o: EventObserver): void&lt;br&gt;+ detach(type, o): void&lt;br&gt;+ publish(e: DomainEvent): void&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;an observer raising an exception is logged and&lt;br&gt;isolated — it cannot fail the enrolment&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="945" y="745" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="EventObserver" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»  — Observer&lt;/i&gt;&lt;br&gt;&lt;b&gt;EventObserver&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ onEvent(e: DomainEvent): void&lt;br&gt;+ interestedIn(): Set&amp;lt;EventType&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1315" y="745" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="WaitlistObserver" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteObserver&lt;/i&gt;&lt;br&gt;&lt;b&gt;WaitlistObserver&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ onEvent(e)&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;on SeatReleased: notify the&lt;br&gt;next waitlisted student that&lt;br&gt;a spot has opened up&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
