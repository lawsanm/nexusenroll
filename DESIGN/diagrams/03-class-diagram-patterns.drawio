    <mxCell id="zFacade" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf5f4;strokeColor=#b85450;dashed=1;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#8c3a37;" value="⑥ FACADE  «Structural»  —  one entry point over the enrolment subsystems&lt;br&gt;&lt;font style=&quot;font-size: 10px;font-weight:normal&quot;&gt;&lt;i&gt;Requirement: &quot;The same back-end services must be usable by both the web application and a future mobile application.&quot;&lt;br&gt;Why: the Service API layer calls one method and holds no business rules. Every collaborator is injected as an abstraction — the Dependency Inversion showcase.&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="620" width="890" x="920" y="1420" as="geometry" />
    </mxCell>
    <mxCell id="EnrollmentFacade" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;Facade&lt;/i&gt;&lt;br&gt;&lt;b&gt;EnrollmentFacade&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- validator: EnrollmentValidator&lt;br&gt;- txManager: TransactionManager&lt;br&gt;- publisher: NotificationPublisher&lt;br&gt;- enrolRepo: IEnrollmentRepository&lt;hr size=&quot;1&quot;&gt;+ enrol(studentId, sectionId): Result&lt;br&gt;+ drop(studentId, sectionId): Result&lt;br&gt;+ forceAdd(adminId, ...): Result&lt;br&gt;+ viewSchedule(studentId, sem): Calendar&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;Depends on abstractions only — every collaborator is&lt;br&gt;injected via constructor (Dependency Inversion)&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="215" width="330" x="945" y="1505" as="geometry" />
    </mxCell>
    <mxCell id="IEnrollmentRepository" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IEnrollmentRepository&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ save(e: Enrollment): void&lt;br&gt;+ findByStudent(id): List&lt;br&gt;+ delete(id): void&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;declared in the Business Logic layer,&lt;br&gt;implemented in the Data Access layer&lt;/i&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="130" width="330" x="945" y="1800" as="geometry" />
    </mxCell>
