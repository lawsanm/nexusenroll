        <mxCell id="AdvisorObserver" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteObserver&lt;/i&gt;&lt;br&gt;&lt;b&gt;AdvisorObserver&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ onEvent(e)&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;on StudentDropped where the&lt;br&gt;course is degree-critical:&lt;br&gt;notify the academic advisor&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1185" y="895" width="225" height="115" as="geometry" />
