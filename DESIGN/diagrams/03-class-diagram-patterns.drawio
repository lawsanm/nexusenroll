        <mxCell id="AdminAlertObserver" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;ConcreteObserver&lt;/i&gt;&lt;br&gt;&lt;b&gt;AdminAlertObserver&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ onEvent(e)&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;on SystemError: alert&lt;br&gt;administrators of any&lt;br&gt;system-wide error&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
