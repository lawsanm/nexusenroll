        <mxCell id="gf24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gR1" target="gR2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gf25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gR2" target="gEnd"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="gNote" value="&lt;b&gt;Why the State pattern earns its place here&lt;/b&gt;&lt;br&gt;&lt;br&gt;The brief asks for &lt;i&gt;&quot;a process for grade approval (e.g. a &amp;quot;Pending&amp;quot; state before a final&lt;br&gt;&amp;quot;Submitted&amp;quot; state)&quot;&lt;/i&gt; and, separately, for graceful partial-failure handling.&lt;br&gt;&lt;br&gt;Both fall out of the same design. Each ConcreteState decides which transitions are&lt;br&gt;legal, so &lt;b&gt;PendingApprovalState&lt;/b&gt; refuses addEntry() while &lt;b&gt;PartiallyRejectedState&lt;/b&gt;&lt;br&gt;permits correctEntry() — and the accepted entries stay in the submission throughout.&lt;br&gt;An illegal call raises IllegalTransition rather than silently corrupting the batch.&lt;br&gt;&lt;br&gt;Full lifecycle: see diagram 06 — State Diagrams." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1055" y="150" width="530" height="200" as="geometry" />
        </mxCell>
        <mxCell id="gNote2" value="&lt;b&gt;Error isolation&lt;/b&gt;&lt;br&gt;Validation is per-entry, not per-batch.&lt;br&gt;One bad letter grade in a roster of 200&lt;br&gt;rejects &lt;u&gt;one&lt;/u&gt; entry, not 200." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1055" y="380" width="290" height="85" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
