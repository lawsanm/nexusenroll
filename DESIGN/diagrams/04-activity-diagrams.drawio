        <mxCell id="f31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="Asuccess" target="SwOk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="SwOk" target="endOk"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="noteTx" value="&lt;b&gt;Transaction Management requirement&lt;/b&gt;&lt;br&gt;&lt;i&gt;&quot;either the entire operation succeeds (the student is enrolled, the class capacity is&lt;br&gt;updated, and the schedule is modified) or the entire operation fails, leaving no&lt;br&gt;partial state changes.&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;The three numbered steps inside execute() are exactly the three state changes named in the&lt;br&gt;requirement. Because they all live in the Enrolment Service's own bounded context, the&lt;br&gt;commit is a single local ACID transaction and undo() provides the failure path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="180" width="580" height="130" as="geometry" />
        </mxCell>
        <mxCell id="noteDecouple" value="&lt;b&gt;Note — why the notification lane comes &lt;u&gt;after&lt;/u&gt; commit&lt;/b&gt;&lt;br&gt;The publish step is fire-and-forget. If every observer failed, the enrolment&lt;br&gt;would still be valid and committed. This is the concrete meaning of&lt;br&gt;&lt;i&gt;&quot;decoupled from the core enrolment logic.&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="330" width="580" height="90" as="geometry" />
        </mxCell>
        <mxCell id="noteWl" value="&lt;b&gt;Waitlist branch.&lt;/b&gt; Distinguishing &quot;full&quot; from&lt;br&gt;&quot;ineligible&quot; matters: a student who fails only the&lt;br&gt;capacity check is eligible and is queued, while a&lt;br&gt;student missing a prerequisite must be rejected." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="930" width="330" height="75" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="activity-grades" name="Activity — Batch Grade Submission">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1400" math="0" shadow="0">
