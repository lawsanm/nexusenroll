          <mxGeometry x="835" y="100" width="130" height="880" as="geometry" />
        </mxCell>
        <mxCell id="llTxMgr" value=":TransactionManager&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;«Command» Invoker&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="985" y="100" width="150" height="880" as="geometry" />
        </mxCell>
        <mxCell id="llCmd" value=":AddCourseCommand&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;«Command» ConcreteCommand&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1150" y="100" width="160" height="880" as="geometry" />
        </mxCell>
        <mxCell id="llPub" value=":NotificationPublisher&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;«Observer» Subject&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
