        <mxCell id="m7" value="2.3: validate(req, ctx)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="460" y="415" as="sourcePoint" /><mxPoint x="900" y="415" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m8" value="ValidationResult(ok) — no TimeSlot overlap" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="900" y="445" as="sourcePoint" /><mxPoint x="460" y="445" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m9" value="ValidationResult(isValid = true)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="460" y="478" as="sourcePoint" /><mxPoint x="280" y="478" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="altFrame" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=26;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="230" y="500" width="1290" height="440" as="geometry" />
        </mxCell>
        <mxCell id="altCond1" value="[ result.isValid() == true ]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#2d7a2d;" vertex="1" parent="1">
          <mxGeometry x="290" y="504" width="240" height="20" as="geometry" />
        </mxCell>

        <mxCell id="m10" value="3: «create» AddCourseCommand(request)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="280" y="548" as="sourcePoint" /><mxPoint x="1230" y="548" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m11" value="4: runAtomic([ command ])" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="280" y="585" as="sourcePoint" /><mxPoint x="1060" y="585" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m12" value="4.1: execute()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="620" as="sourcePoint" /><mxPoint x="1230" y="620" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="cmdNote" value="&lt;b&gt;the three atomic state changes&lt;/b&gt;&lt;br&gt;1.&amp;nbsp; enrolRepo.save(new Enrollment)&lt;br&gt;2.&amp;nbsp; section.reserveSeat()&lt;br&gt;3.&amp;nbsp; schedule.addSection(section)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;each step is recorded so undo() can reverse it&lt;/i&gt;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="632" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="740" as="sourcePoint" /><mxPoint x="1060" y="740" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m14" value="4.2: commit()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="765" as="sourcePoint" /><mxPoint x="1060" y="795" as="targetPoint" />
            <Array as="points"><mxPoint x="1120" y="765" /><mxPoint x="1120" y="795" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m15" value="TxResult(success)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="825" as="sourcePoint" /><mxPoint x="280" y="825" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m16" value="5: publish(StudentEnrolled)&amp;nbsp;&amp;nbsp;&lt;i&gt;asynchronous, fire-and-forget&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;rounded=0;fontSize=11;strokeColor=#d6b656;fontColor=#8a6d1f;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="280" y="862" as="sourcePoint" /><mxPoint x="1420" y="862" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m17" value="6: EnrolmentConfirmation + updated schedule" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="280" y="900" as="sourcePoint" /><mxPoint x="110" y="900" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="altDivider" value="" style="line;strokeWidth=1;html=1;dashed=1;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="908" width="1290" height="10" as="geometry" />
        </mxCell>
        <mxCell id="altCond2" value="[ else — one or more rules failed ]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="240" y="916" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m18" value="7: Rejection( every failed rule )&amp;nbsp;&amp;nbsp;&lt;i&gt;no state was changed&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="280" y="960" as="sourcePoint" /><mxPoint x="110" y="960" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="noteFacade" value="&lt;b&gt;Facade ⑥ in one line&lt;/b&gt;&lt;br&gt;The Student sends exactly &lt;b&gt;one&lt;/b&gt; message and receives one reply.&lt;br&gt;Everything between messages 2 and 6 — validation strategy selection,&lt;br&gt;command construction, transaction control, event publication — is hidden&lt;br&gt;behind the facade. The Service API layer therefore contains no business rules." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="1010" width="470" height="100" as="geometry" />
        </mxCell>
        <mxCell id="noteObs" value="&lt;b&gt;Observer ④ — why message 5 is an open arrowhead&lt;/b&gt;&lt;br&gt;Message 5 is asynchronous and message 6 does not wait for it. The Facade holds&lt;br&gt;no reference to any observer and never learns whether delivery succeeded.&lt;br&gt;Observer fan-out is shown on page 2 (&lt;i&gt;Drop → Waitlist Notification&lt;/i&gt;)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="535" y="1010" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="noteCmd" value="&lt;b&gt;Command ② — the failure path&lt;/b&gt;&lt;br&gt;If step 2 or 3 inside execute() raises, TransactionManager pops its stack&lt;br&gt;and calls undo() on every already-executed command in reverse order,&lt;br&gt;then returns TxResult(failure). No partial state change survives.&lt;br&gt;See diagram 04 (Activity) for the full rollback branch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1055" y="1010" width="465" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="seq-drop" name="Sequence — Drop Course → Waitlist Notification">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dTitle" value="Sequence Diagram — Student Drops a Course → Automated Waitlist &amp;amp; Advisor Notification&lt;br&gt;&lt;font style=&quot;font-size: 12px;font-weight:normal&quot;&gt;Use case from §4: &lt;i&gt;&quot;A student drops a course. The notification system must automatically alert any waitlisted students that a spot has opened up. This process should be automated and &lt;b&gt;decoupled&lt;/b&gt; from the core enrolment logic.&quot;&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1590" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dStudent" value=":Student" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;participant=umlActor;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="100" width="130" height="820" as="geometry" />
        </mxCell>
        <mxCell id="dFacade" value=":EnrollmentFacade&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;«Facade»&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="190" y="100" width="160" height="820" as="geometry" />
        </mxCell>
        <mxCell id="dTx" value=":TransactionManager&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;«Command» Invoker&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="160" height="820" as="geometry" />
        </mxCell>
        <mxCell id="dCmd" value=":DropCourseCommand&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ConcreteCommand&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="535" y="100" width="170" height="820" as="geometry" />
        </mxCell>
        <mxCell id="dSvc" value=":NotificationService&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;single instance, constructor-injected&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="100" width="180" height="820" as="geometry" />
        </mxCell>
        <mxCell id="dPub" value=":NotificationPublisher&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;«Observer» Subject&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="915" y="100" width="170" height="820" as="geometry" />
        </mxCell>
        <mxCell id="dWlObs" value=":WaitlistObserver&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ConcreteObserver&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1100" y="100" width="160" height="820" as="geometry" />
        </mxCell>
        <mxCell id="dAdvObs" value=":AdvisorObserver&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ConcreteObserver&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1270" y="100" width="160" height="820" as="geometry" />
        </mxCell>
        <mxCell id="dEmail" value=":EmailChannel" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1465" y="100" width="130" height="820" as="geometry" />
        </mxCell>

        <mxCell id="dm1" value="1: drop(studentId, sectionId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="180" as="sourcePoint" /><mxPoint x="270" y="180" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dm2" value="2: runAtomic([ DropCourseCommand ])" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="218" as="sourcePoint" /><mxPoint x="440" y="218" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dm3" value="2.1: execute()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="255" as="sourcePoint" /><mxPoint x="620" y="255" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dCmdNote" value="&lt;b&gt;atomic state changes&lt;/b&gt;&lt;br&gt;1.&amp;nbsp; enrolment.drop()&lt;br&gt;2.&amp;nbsp; section.releaseSeat()&lt;br&gt;3.&amp;nbsp; schedule.removeSection()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;snapshot taken first so undo() can restore&lt;/i&gt;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="628" y="268" width="240" height="88" as="geometry" />
        </mxCell>
        <mxCell id="dm4" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="620" y="378" as="sourcePoint" /><mxPoint x="440" y="378" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="dm5" value="3: commit()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="400" as="sourcePoint" /><mxPoint x="440" y="428" as="targetPoint" />
            <Array as="points"><mxPoint x="500" y="400" /><mxPoint x="500" y="428" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="dm6" value="TxResult(success)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;" edge="1" parent="1">
