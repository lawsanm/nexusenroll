        </mxCell>
        <mxCell id="loopNote" value="&lt;i&gt;loop — the Context iterates every registered ValidationRule&lt;br&gt;and aggregates the results (Strategy ①)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#3d6b2e;" vertex="1" parent="1">
