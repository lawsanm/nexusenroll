        <mxCell id="dm13" value="4.1.3: onEvent(StudentDropped)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="800" as="sourcePoint" /><mxPoint x="1350" y="800" as="targetPoint" /></mxGeometry>
