        </mxCell>
        <mxCell id="dm8" value="5: DropConfirmation&amp;nbsp;&amp;nbsp;&lt;i&gt;returns immediately — does not wait for any notification&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="534" as="sourcePoint" /><mxPoint x="100" y="534" as="targetPoint" /></mxGeometry>
