        <mxCell id="boundaryLbl" value="▲ &amp;nbsp;the enrolment transaction is COMMITTED and the student already has their answer &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; ▼ &amp;nbsp;everything below is asynchronous and fully DECOUPLED from the enrolment logic" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="30" y="562" width="1590" height="20" as="geometry" />
        </mxCell>

