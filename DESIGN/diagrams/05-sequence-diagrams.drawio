        <mxCell id="parFrame" value="par" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=26;fillColor=none;strokeColor=#8a6d1f;fontSize=11;fontStyle=1;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="960" y="630" width="660" height="250" as="geometry" />
        </mxCell>
        <mxCell id="parLbl" value="each subscriber is notified independently — one failing observer cannot affect the others" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#8a6d1f;" vertex="1" parent="1">
          <mxGeometry x="1015" y="634" width="600" height="20" as="geometry" />
